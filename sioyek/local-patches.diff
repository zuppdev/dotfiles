 extern float UI_SELECTED_TEXT_COLOR[3];
 extern float UI_SELECTED_BACKGROUND_COLOR[3];
@@ -2674,6 +2675,22 @@ QString get_ui_stylesheet(bool nofont, int font_size) {
 }
 
 QString get_status_stylesheet(bool nofont, int font_size) {
+    // get_color_stylesheet emits an opaque #rrggbb. When status_bar_alpha is
+    // below 1.0, emit rgba() instead so the page shows through the bar.
+    if (STATUS_BAR_ALPHA < 1.0f) {
+        QString background = QString("rgba(%1, %2, %3, %4)")
+            .arg(static_cast<int>(STATUS_BAR_COLOR[0] * 255.0f))
+            .arg(static_cast<int>(STATUS_BAR_COLOR[1] * 255.0f))
+            .arg(static_cast<int>(STATUS_BAR_COLOR[2] * 255.0f))
+            .arg(STATUS_BAR_ALPHA, 0, 'f', 3);
+        QString foreground = get_color_qml_string(
+            STATUS_BAR_TEXT_COLOR[0], STATUS_BAR_TEXT_COLOR[1], STATUS_BAR_TEXT_COLOR[2]);
+        int size = font_size > 0 ? font_size : STATUS_BAR_FONT_SIZE;
+        QString font_part = ((!nofont) && (size > -1))
+            ? QString(" font-size: %1px;").arg(size) : QString();
+        return QString("background-color: %1; color: %2; border: 0;%3")
+            .arg(background, foreground, font_part);
+    }
     return get_color_stylesheet(STATUS_BAR_COLOR, STATUS_BAR_TEXT_COLOR, nofont, font_size);
 }
 
