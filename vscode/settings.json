        "**/obj/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.pub-cache/**": true
    },
    "search.exclude": {
        "**/node_modules/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.gradle/**": true,
        "**/build/**": true,
        "**/.dart_tool/**": true,
        "**/Pods/**": true,
        "**/dist/**": true,
        "**/.next/**": true,
        "**/target/**": true,
        "**/bin/**": true,
        "**/obj/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.pub-cache/**": true
    },
    "python.analysis.exclude": [
        "**/node_modules/**",
        "**/.git/objects/**",
        "**/.git/subtree-cache/**",
        "**/.gradle/**",
        "**/build/**",
        "**/.dart_tool/**",
