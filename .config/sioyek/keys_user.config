# Additions to sioyek's defaults, which are already vim-ish:
#   gg / G  top / bottom      j / k      line down / up
#   /       search            t          table of contents
#   b       bookmark          O          previous document
#   f       follow a link or citation into an overlay
#   +/-/=   zoom in / out / fit width
#
# f1, f4..f12 are taken by the defaults; f2, f3, c and C are free.

# Flip the Rose Pine recolouring off, to check a figure's real colours.
toggle_custom_color     c

# Upstream puts dark mode on f8; mirror it next to the custom toggle.
toggle_dark_mode        C

# Chrome off, for reading full-bleed.
toggle_statusbar        <f2>
toggle_titlebar         <f3>
