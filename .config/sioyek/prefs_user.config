# Rose Pine (main) for sioyek - https://rosepinetheme.com
#
# Colours are r g b floats in 0..1. Reference, as hex -> float:
#   base          #191724   0.098 0.090 0.141
#   surface       #1f1d2e   0.122 0.114 0.180
#   overlay       #26233a   0.149 0.137 0.227
#   highlight med #403d52   0.251 0.239 0.322
#   muted         #6e6a86   0.431 0.416 0.525
#   subtle        #908caa   0.565 0.549 0.667
#   text          #e0def4   0.878 0.871 0.957
#   love          #eb6f92   0.922 0.435 0.573
#   gold          #f6c177   0.965 0.757 0.467
#   rose          #ebbcba   0.922 0.737 0.729
#   pine          #31748f   0.192 0.455 0.561
#   foam          #9ccfd8   0.612 0.812 0.847
#   iris          #c4a7e7   0.769 0.655 0.906

# Application background, around the page. base, so it matches iTerm.
background_color                0.145 0.137 0.220

# background_color is only used in normal colour mode. In custom colour mode
# the area around the page clears to this instead, and it defaults to pure
# black - which is what made the native titlebar strip (macos_titlebar_color,
# drawn by the NSWindow outside Qt's widget tree) read as a separate bar.
custom_color_mode_empty_background_color  0.145 0.137 0.220

# Same again for dark mode, so toggling with C does not reintroduce the seam.
dark_mode_background_color      0.145 0.137 0.220

# toggle_custom_color remaps the page itself: paper white -> base,
# ink black -> text. This is the setting that actually themes the PDF.
custom_background_color         0.145 0.137 0.220
custom_text_color               0.878 0.871 0.957

# LaTeX hyperref draws citations in blue and the custom colour transform maps
# a blue basis straight through, so they stayed blue against the Rose Pine
# page. This sends that basis somewhere purple instead.
#
# It is not simply iris. The transform is affine over four basis colours
# (white, black, red, blue), and this paper's links are #0079ff, which
# decomposes with a NEGATIVE red coefficient (-0.475). That subtracts red from
# the result, capping the achievable red at 0.514 - iris would need a blue
# basis of R=1.486. These values are solved to land on #8366e6, the most
# vivid in-range violet. Verified: a pure-red basis predicts #833d85 and
# measures #833d85 exactly.
# (custom_blue_color is a local patch to pdf_view_opengl_widget.cpp.)
custom_blue_color               1.000 0.240 0.650

# Turn it on at launch rather than per-document.
# toggle_statusbar hides the page readout entirely. There is no config to
# suppress it, so it is toggled off at launch instead. f2 brings it back.
startup_commands                toggle_custom_color;toggle_statusbar

# Hide the titlebar the way iTerm does, natively: titleVisibility hidden,
# NSWindowStyleMaskFullSizeContentView, titlebarAppearsTransparent, traffic
# lights hidden until the cursor enters the top strip. This keeps a real
# NSWindow, so the rounded corners and the drop shadow survive.
# The toggle_titlebar command instead sets Qt's FramelessWindowHint, which
# throws away the corners and the shadow with them.
macos_hide_titlebar             1
macos_titlebar_color            0.145 0.137 0.220

# Selection, search, links
text_highlight_color            0.251 0.239 0.322
search_highlight_color          0.965 0.757 0.467
link_highlight_color            0.612 0.812 0.847
synctex_highlight_color         0.769 0.655 0.906
visual_mark_color               0.769 0.655 0.906 0.12

# Status bar - overlay, the same colour as the sketchybar pills
status_bar_color                0.145 0.137 0.220
status_bar_text_color           0.878 0.871 0.957
page_separator_color            0.149 0.137 0.227

# Annotation highlight palette, cycled with the a..z highlight types
highlight_color_a               0.922 0.435 0.573
highlight_color_b               0.965 0.757 0.467
highlight_color_c               0.922 0.737 0.729
highlight_color_d               0.192 0.455 0.561
highlight_color_e               0.612 0.812 0.847
highlight_color_f               0.769 0.655 0.906

ui_font                         JetBrainsMono Nerd Font
font_size                       16
status_bar_font_size            15

# --- status bar -------------------------------------------------------
# The status label is stacked above the GL widget, so alpha 0 lets the page
# show straight through: the readout floats on the paper instead of sitting
# on a slab. Raise toward 1.0 for a scrim if a figure ever sits behind it.
# (status_bar_alpha is a local patch to utils.cpp/config.cpp, not upstream.)
status_bar_alpha                0.0

# Upstream: "[ %{current_page} / %{num_pages} ]" plus %{highlight}, which
# pins a permanent "[ h:a ]" to the bar. Dropped both, kept every indicator
# that only appears while something is actually happening.
status_bar_format               %{current_page} / %{num_pages}%{search_results}%{search_progress}%{link_status}%{waiting_for_symbol}%{indexing}%{synctex}%{presentation}%{custom_message}%{download}

# Section you are currently in - worth the right-hand slot in a paper.
right_status_bar_format         %{chapter_name}
