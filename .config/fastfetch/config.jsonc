{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    { "type": "title", "format": "Zap@Macbook-Pro" },
    "separator",
    "os",
    { "type": "host", "format": "macbook pro m4 pro" },
    "kernel",
    "uptime",
    "packages",
    "shell",
    // The display module shares one format across every screen, so it cannot
    // name them individually. Static lines instead.
    { "type": "custom", "key": "Display", "format": "ASUS ROG AQWMG 2K OLED" },
    { "type": "custom", "key": "Display", "format": "Liquid Retina XDR 120 Hz" },
    "wm",
    "terminal",
    "terminalfont",
    { "type": "cpu", "key": "CPU", "format": "apple silicon m4 pro" },
    { "type": "gpu", "key": "GPU", "format": "{core-count}-core" },
    "memory",
    { "type": "disk", "key": "Disk", "format": "1 TB ({size-percentage} used)" },
    { "type": "battery", "key": "Battery", "format": "{capacity} [{status}]" },
    "break",
    "colors"
  ]
}
